# Fizzo Hotels backend - example environment configuration
# Copy this file to .env and fill in real values. .env is gitignored.

# Database connection (PostgreSQL JDBC URL)
DB_URL=jdbc:postgresql://localhost:5432/fizzo_hotels_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT signing secret - MUST be at least 32 characters for HS256.
# Generate one: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Access token lifetime in milliseconds (default: 24h)
JWT_EXPIRATION_MS=86400000

# Logging level for the application package (DEBUG | INFO | WARN)
LOG_LEVEL=DEBUG

# JPA tuning for production: set JPA_DDL_AUTO=validate (or none) and JPA_SHOW_SQL=false
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
